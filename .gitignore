# Reference repositories cloned for one-shot porting and for the game's own
# -debug dumps. The build must never depend on these; `npm run verify:norefs`
# proves it. Re-fetch with `npm run refs:sync`.
/refs/

node_modules/
dist/
*.tsbuildinfo
.refs-parked-by-verify/

# Generated reports are not written to disk: a gap list reads as a spec, and
# these are defects. `verify:conformance` and `verify:reproduce` print instead.
/docs/
