{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "isolatedDeclarations": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "paths": {
      "@kongyo2/stellaris-ts": ["./src/index.ts"],
      "@kongyo2/stellaris-ts/*": ["./src/*/index.ts"]
    }
  },
  "include": ["examples/**/*.ts"],
  "exclude": []
}
